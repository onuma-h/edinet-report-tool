# ============================================================
# edinet-report-tool 環境変数のサンプル
# このファイルを .env にコピーして値を書き換えてください（.env は Git に含まれません）。
# 各自の環境に合わせて設定
# ============================================================

# --- EDINET API キー（必須）---------------------------------
# EDINET API v2 の Subscription-Key。金融庁の EDINET 公式サイトで取得できます。
# 各自の環境に合わせて設定
EDINET_API_KEY=YOUR_API_KEY

# --- J-Quants API キー（スクリーニング機能を使う場合のみ）------
# screening/ フォルダの上場銘柄一覧・株価の取得に使います。
# 各自の環境に合わせて設定
JQUANTS_API_KEY=YOUR_API_KEY
